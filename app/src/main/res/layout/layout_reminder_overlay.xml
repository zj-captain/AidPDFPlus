<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reminder_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reminder_overlay"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/reminder_close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/close"
        android:padding="3dp"
        android:src="@drawable/img_close_overlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/reminder_image"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/img_notice_pdf" />

    <TextView
        android:id="@+id/reminder_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="18dp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:textStyle="bold"
        android:textColor="@color/reminder_text"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminder_image"
        tools:text="Tap to browse your PDF doc" />

    <TextView
        android:id="@+id/reminder_action"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_reminder_action"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminder_message"
        tools:text="Check" />
</androidx.constraintlayout.widget.ConstraintLayout>
