<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/dialog_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_uninstall_sheet_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="62dp"
        android:paddingEnd="14dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="190dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:background="#EFEFEF" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/uninstall_confirm_message"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/uninstall_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_uninstall_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/uninstall_action"
            android:textColor="#C9C9C9"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_uninstall_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/uninstall_continue_using"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dialog_logo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@string/uninstall_confirm_message"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/img_uninstall_dialog_logo" />

</FrameLayout>
