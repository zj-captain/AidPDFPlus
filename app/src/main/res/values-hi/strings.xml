    <string-array name="reminder_time_messages">
        <item>Word ड्राफ्ट 5 मिनट में देय है। इसे जाँचें।</item>
        <item>Word टिप्पणियाँ उत्तर की प्रतीक्षा कर रही हैं। 4 मिनट में उत्तर दें।</item>
        <item>Excel शीट में त्रुटियाँ हैं। उन्हें 3 मिनट में ठीक करें।</item>
        <item>Excel रिपोर्ट की समय सीमा निकल चुकी है। इसे 7 मिनट में जमा करें।</item>
        <item>PPT स्लाइड 6 मिनट में देय हैं। उन्हें अभी पूरा करें।</item>
        <item>PPT फ़ीडबैक तैयार है। इसे 5 मिनट में देखें।</item>
        <item>PDF अनुबंध पर हस्ताक्षर चाहिए। 2 मिनट में हस्ताक्षर करें।</item>
        <item>PDF फ़ॉर्म अधूरा है। इसे 3 मिनट में भरें।</item>
    </string-array>
    <string-array name="reminder_unlock_messages">
        <item>Word संस्करण पुराना है। इसे 8 मिनट में अपडेट करें।</item>
        <item>Word ड्राफ्ट में टकराव हैं। उन्हें 5 मिनट में सुलझाएँ।</item>
        <item>Excel रिपोर्ट 10 मिनट में देय है। जल्दी करें।</item>
        <item>Excel डेटा अधूरा है। इसे 6 मिनट में दर्ज करें।</item>
        <item>PPT प्रस्तुति 6 मिनट में शुरू होगी। तैयार हो जाएँ।</item>
        <item>PPT स्लाइड का क्रम गलत है। उन्हें 3 मिनट में दोबारा व्यवस्थित करें।</item>
        <item>PDF इनवॉइस को मंज़ूरी चाहिए। 4 मिनट में मंज़ूर करें।</item>
        <item>PDF में नए नोट हैं। उन्हें 5 मिनट में देखें।</item>
    </string-array>
    <string-array name="reminder_alarm_messages">
        <item>Word की अंतिम मंज़ूरी लंबित है। 2 मिनट में निर्णय लें।</item>
        <item>Word का ज़रूरी काम जल्द देय है। इसे 5 मिनट में पूरा करें।</item>
        <item>Excel पिवट तालिका में समस्या है। इसे 5 मिनट में ठीक करें।</item>
        <item>Excel पूर्वानुमान पीछे चल रहा है। इसे 8 मिनट में अपडेट करें।</item>
        <item>PPT फ़ाइल बहुत बड़ी है। इसे 4 मिनट में कंप्रेस करें।</item>
        <item>PPT एनिमेशन अधूरे हैं। उन्हें 2 मिनट में जोड़ें।</item>
        <item>PDF रसीद का सत्यापन ज़रूरी है। इसे 3 मिनट में सत्यापित करें।</item>
        <item>PDF हस्ताक्षर अंतिम चरण है। 4 मिनट में हस्ताक्षर करें।</item>
    </string-array>
